#Область РегистрацияРасширенияФормата

// URI расширения формата (латиница, совпадает с targetNamespace XSD и URI в КД 3.0).
Функция URIРасширенияФормата() Экспорт
	Возврат "http://uso2.local/EnterpriseData/1.20/Кадры";
КонецФункции

// Вызывается из &После("ПриПолученииДоступныхРасширенийФормата")
// заимствованного ОбщегоМодуля.ОбменДаннымиПереопределяемый.
//
// Параметры:
//   РасширенияФормата - Соответствие: Ключ = URI схемы расширения, Значение = расширяемая версия EnterpriseData.
Процедура ПриПолученииДоступныхРасширенийФормата(РасширенияФормата) Экспорт
	РасширенияФормата.Вставить(URIРасширенияФормата(), "1.20");
КонецПроцедуры

#КонецОбласти
