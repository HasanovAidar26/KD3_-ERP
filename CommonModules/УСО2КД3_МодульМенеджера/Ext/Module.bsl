// ПередЗаписьюПолученныхДанных для справочников: если объект уже существует в ИБ приёмника (ERP),
// не перезаписываем его реквизиты данными из источника (ЗУП) — только сопоставление по ключу.
Процедура УСО2КД3_НеПерезаписыватьСуществующий(Параметры)
	Если Параметры.ДанныеИБ <> Неопределено Тогда
		Параметры.ПолученныеДанные = Неопределено;
	КонецЕсли;
КонецПроцедуры

// ПередЗаписьюПолученныхДанных для позиций штатного расписания.
// Начисления/ФОТ позиции ведёт ERP — обменом их НЕ перезаписываем.
//  - Позиция сопоставлена с существующей в ERP (по GUID/ключу):
//      * если входящая ЗАКРЫТА — у существующей проставляем ТОЛЬКО «Закрыта»+«ДатаЗакрытия»
//        (начисления и прочие данные не трогаем);
//      * в любом случае существующую позицию входящими данными не перезаписываем.
//  - Позиция не сопоставлена (новая) — создаётся, но начисления/ФОТ заполняются
//    из «такой же» позиции ШР (тот же Владелец+Наименование+Подразделение+Должность),
//    самой последней по ДатаУтверждения (как правило — только что закрытая старая версия).
Процедура УСО2КД3_ШтатноеРасписание_ПередЗаписью(Параметры)
	Если Параметры.ПолученныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// (А) НОВАЯ позиция (нет сопоставления по GUID) — заполняем начисления/ФОТ из близнеца ERP
	//     и закрываем старые активные позиции с тем же Владелец+Подразделение+Должность
	//     (одноимённых активных позиций одной должности в подразделении быть не должно).
	Если Параметры.ДанныеИБ = Неопределено Тогда
		Попытка
			Новая = Параметры.ПолученныеДанные;
			КолСтрок = УСО2КД3_СкопироватьНачисленияИзБлизнеца(Новая);
			ДатаЗакр = ?(ЗначениеЗаполнено(Новая.ДатаУтверждения),
				НачалоДня(Новая.ДатаУтверждения), НачалоДня(ТекущаяДатаСеанса()));
			КолЗакрыто = УСО2КД3_ЗакрытьСтарыеПозицииШР(Новая, ДатаЗакр);
			УСО2КД3_ЛогШР("Новая позиция", Новая, КолСтрок, КолЗакрыто);
		Исключение
			УСО2КД3_ЛогОшибкиШР("создание новой позиции");
		КонецПопытки;
		Возврат;
	КонецЕсли;

	// (Б) СОПОСТАВЛЕНО с существующей позицией ERP.
	Попытка
		Объект = Параметры.ДанныеИБ;
		Если ТипЗнч(Объект) = Тип("СправочникСсылка.ШтатноеРасписание") Тогда
			Объект = Объект.ПолучитьОбъект();
		КонецЕсли;
		Если Параметры.ПолученныеДанные.Закрыта = Истина Тогда
			// Закрытие существующей позиции — начисления/ФОТ НЕ трогаем.
			Если Объект.Закрыта <> Истина Тогда
				Объект.Закрыта = Истина;
				Если ЗначениеЗаполнено(Параметры.ПолученныеДанные.ДатаЗакрытия) Тогда
					Объект.ДатаЗакрытия = Параметры.ПолученныеДанные.ДатаЗакрытия;
				ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ДатаЗакрытия) Тогда
					Объект.ДатаЗакрытия = НачалоДня(ТекущаяДатаСеанса());
				КонецЕсли;
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.Записать();
			КонецЕсли;
		ИначеЕсли Объект.Начисления.Количество() = 0 Тогда
			// Активная позиция без начислений (напр. создана пустой раньше) — дозаполняем из близнеца.
			КолСтрок = УСО2КД3_СкопироватьНачисленияИзБлизнеца(Объект);
			Если КолСтрок > 0 Тогда
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.Записать();
			КонецЕсли;
			УСО2КД3_ЛогШР("Дозаполнение существующей", Объект, КолСтрок);
		КонецЕсли;
	Исключение
		УСО2КД3_ЛогОшибкиШР("сопоставленная позиция");
	КонецПопытки;

	// Существующую позицию входящими данными не перезаписываем (сохраняем начисления/ФОТ ERP).
	Параметры.ПолученныеДанные = Неопределено;
КонецПроцедуры

// Копирует начисления/показатели/ФОТ из «близнеца» (последней по ДатаУтверждения позиции
// с тем же Владелец+Подразделение+Должность) в переданную позицию ШР.
// Возвращает число скопированных строк начислений, либо -1 если близнец не найден.
Функция УСО2КД3_СкопироватьНачисленияИзБлизнеца(Позиция)
	Источник = УСО2КД3_НайтиПоследнююПозициюШР(Позиция);
	Если Источник = Неопределено Тогда
		Возврат -1;
	КонецЕсли;
	ТаблицаНачислений = Источник.Начисления.Выгрузить();
	Позиция.Начисления.Загрузить(ТаблицаНачислений);
	Позиция.Показатели.Загрузить(Источник.Показатели.Выгрузить());
	Попытка
		Позиция.УправленческиеНачисления.Загрузить(Источник.УправленческиеНачисления.Выгрузить());
	Исключение
	КонецПопытки;
	Если ЗначениеЗаполнено(Источник.ОкладТариф) Тогда
		Позиция.ОкладТариф = Источник.ОкладТариф;
	КонецЕсли;
	Если ЗначениеЗаполнено(Источник.ФОТ) Тогда
		Позиция.ФОТ = Источник.ФОТ;
	КонецЕсли;
	Возврат ТаблицаНачислений.Количество();
КонецФункции

// Закрывает все АКТИВНЫЕ позиции ШР с тем же Владелец+Подразделение+Должность, кроме самой позиции.
// Возвращает число закрытых позиций.
Функция УСО2КД3_ЗакрытьСтарыеПозицииШР(Позиция, ДатаЗакрытия)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШР.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ШтатноеРасписание КАК ШР
	|ГДЕ
	|	ШР.Владелец = &Владелец
	|	И ШР.Подразделение = &Подразделение
	|	И ШР.Должность = &Должность
	|	И ШР.Ссылка <> &Ссылка
	|	И ШР.Закрыта = ЛОЖЬ";
	Запрос.УстановитьПараметр("Владелец", Позиция.Владелец);
	Запрос.УстановитьПараметр("Подразделение", Позиция.Подразделение);
	Запрос.УстановитьПараметр("Должность", Позиция.Должность);
	Запрос.УстановитьПараметр("Ссылка", Позиция.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	КолЗакрыто = 0;
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.Закрыта = Истина;
		Если ЗначениеЗаполнено(ДатаЗакрытия) Тогда
			Объект.ДатаЗакрытия = ДатаЗакрытия;
		ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ДатаЗакрытия) Тогда
			Объект.ДатаЗакрытия = НачалоДня(ТекущаяДатаСеанса());
		КонецЕсли;
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();
		КолЗакрыто = КолЗакрыто + 1;
	КонецЦикла;
	Возврат КолЗакрыто;
КонецФункции

// Пишет в журнал регистрации результат обработки позиции ШР.
Процедура УСО2КД3_ЛогШР(Этап, Позиция, КолСтрок, КолЗакрыто = 0)
	Попытка
		Текст = Этап + " ШР: """ + Строка(Позиция.Наименование) + """"
			+ " | Подр=" + Строка(Позиция.Подразделение)
			+ " Долж=" + Строка(Позиция.Должность)
			+ " ДатаУтв=" + Строка(Позиция.ДатаУтверждения)
			+ " | " + ?(КолСтрок < 0, "близнец НЕ НАЙДЕН", "скопировано строк начислений=" + Строка(КолСтрок))
			+ " | закрыто старых позиций=" + Строка(КолЗакрыто);
		ЗаписьЖурналаРегистрации("УСО2КД3.ШР", УровеньЖурналаРегистрации.Информация, , Позиция.Ссылка, Текст);
	Исключение
	КонецПопытки;
КонецПроцедуры

// Пишет в журнал регистрации ошибку обработки позиции ШР.
Процедура УСО2КД3_ЛогОшибкиШР(Контекст)
	Попытка
		ЗаписьЖурналаРегистрации("УСО2КД3.ШР", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка ШР (" + Контекст + "): " + ОписаниеОшибки());
	Исключение
	КонецПопытки;
КонецПроцедуры

// Ищет «такую же» позицию ШР в ERP: тот же Владелец+Подразделение+Должность (надёжные ссылочные
// поля; Наименование/НаименованиеПолное на входящем объекте могут быть не заполнены). Из подходящих
// берётся самая поздняя по ДатаУтверждения, с приоритетом совпадения Наименования. Исключает саму
// позицию. Возвращает СправочникСсылка или Неопределено.
Функция УСО2КД3_НайтиПоследнююПозициюШР(Позиция)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ШР.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ШтатноеРасписание КАК ШР
	|ГДЕ
	|	ШР.Владелец = &Владелец
	|	И ШР.Подразделение = &Подразделение
	|	И ШР.Должность = &Должность
	|	И ШР.Ссылка <> &Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР КОГДА ШР.Наименование = &Наименование ТОГДА 0 ИНАЧЕ 1 КОНЕЦ,
	|	ШР.ДатаУтверждения УБЫВ";
	Запрос.УстановитьПараметр("Владелец", Позиция.Владелец);
	Запрос.УстановитьПараметр("Подразделение", Позиция.Подразделение);
	Запрос.УстановитьПараметр("Должность", Позиция.Должность);
	Запрос.УстановитьПараметр("Ссылка", Позиция.Ссылка);
	Запрос.УстановитьПараметр("Наименование", Позиция.Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Возвращает версию формата менеджера обмена.
// Возвращаемое значение:
//  Число - номер версии.
Функция ВерсияФорматаМенеджераОбмена() Экспорт
    Возврат "2";
КонецФункции

