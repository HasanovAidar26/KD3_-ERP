		ДобавитьПКО_СправочникСсылка_ПодразделенияОрганизаций_Справочн(ПравилаКонвертации);
		ДобавитьПКО_СправочникСсылка_Сотрудники_Справочник_Сотрудники(ПравилаКонвертации);
		ДобавитьПКО_СправочникСсылка_ФизическиеЛица_Справочник_Физичес(ПравилаКонвертации);
		ДобавитьПКО_СправочникСсылка_ШтатноеРасписание_Справочник_Штат(ПравилаКонвертации);
		ДобавитьПКО_УСО2КД3_ПодрОргРегл(ПравилаКонвертации);
		ДобавитьПКО_УСО2КД3_ГрафикиРаботы(ПравилаКонвертации);
		ДобавитьПКО_УСО2КД3_Начисления(ПравилаКонвертации);
		ДобавитьПКО_УСО2КД3_Показатели(ПравилаКонвертации);
	КонецЕсли;
КонецПроцедуры

Функция ДобавитьПКТЧ(ПравилоКонвертации, ИмяТЧКонфигурации, ИмяТЧФормата)
    Если ПравилоКонвертации.СвойстваТабличныхЧастей.Колонки.Количество() = 0 Тогда
        ОбменДаннымиXDTOСервер.ИнициализироватьСвойстваТабличныхЧастей(ПравилоКонвертации);
    КонецЕсли;
    КонвертацияТабличнойЧасти                = ПравилоКонвертации.СвойстваТабличныхЧастей.Добавить();
    КонвертацияТабличнойЧасти.ТЧКонфигурации = ИмяТЧКонфигурации;
    КонвертацияТабличнойЧасти.ТЧФормата      = ИмяТЧФормата;
    КонвертацияТабличнойЧасти.Свойства       = ОбменДаннымиXDTOСервер.ИнициализироватьТаблицуСвойствДляПравилаКонвертации();
    Возврат КонвертацияТабличнойЧасти.Свойства;
КонецФункции

Процедура ДобавитьПКС(РодительПКС, СвойствоКонфигурации, СвойствоФормата, ИспользуетсяАлгоритмКонвертации = 0, 
                    ПравилоКонвертацииСвойства = "")
	НоваяСтрока                                 = РодительПКС.Добавить();
	НоваяСтрока.СвойствоКонфигурации            = СвойствоКонфигурации;
	НоваяСтрока.СвойствоФормата                 = СвойствоФормата;
	НоваяСтрока.ИспользуетсяАлгоритмКонвертации = ?(ИспользуетсяАлгоритмКонвертации = 0, Ложь, Истина);
	НоваяСтрока.ПравилоКонвертацииСвойства      = ПравилоКонвертацииСвойства;
КонецПроцедуры

#Область Получение
#Область ДокументСсылка_ПриемНаРаботу_Документ_ПриемНаРабот
Процедура ДобавитьПКО_ДокументСсылка_ПриемНаРаботу_Документ_ПриемНаРабот(ПравилаКонвертации)

	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "ДокументСсылка_ПриемНаРаботу_Документ_ПриемНаРабот";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Документы.ПриемНаРаботу;
	ПравилоКонвертации.ОбъектФормата                = "Документ.ПриемНаРаботу";
	ОбменДаннымиXDTOСервер.ИнициализироватьРасширениеПравилаКонвертацииОбъекта(ПравилоКонвертации, "http://uso2.local/EnterpriseData/1.20/Кадры");
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO = "УСО2КД3_ВидЗанятости_Получение";
	ПравилоКонвертации.ВариантИдентификации         = "ПоУникальномуИдентификатору";
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Дата",                          "Дата");
	ДобавитьПКС(СвойстваШапки, "ДатаПриема",                    "ДатаПриема");
	ДобавитьПКС(СвойстваШапки, "Должность",                     "Должность", , "СправочникСсылка_Должности_Справочник_Должности");
	ДобавитьПКС(СвойстваШапки, "ДолжностьПоШтатномуРасписанию", "ДолжностьПоШтатномуРасписанию", , "СправочникСсылка_ШтатноеРасписание_Справочник_Штат");
	ДобавитьПКС(СвойстваШапки, "КоличествоСтавок",              "КоличествоСтавок");
	ДобавитьПКС(СвойстваШапки, "Комментарий",                   "Комментарий");
	ДобавитьПКС(СвойстваШапки, "Номер",                         "Номер");
	ДобавитьПКС(СвойстваШапки, "Организация",                   "Организация", , "СправочникСсылка_Организации_Справочник_Организаци");
	ДобавитьПКС(СвойстваШапки, "Подразделение",                 "Подразделение", , "СправочникСсылка_ПодразделенияОрганизаций_Справочн");
	ДобавитьПКС(СвойстваШапки, "Сотрудник",                     "Сотрудник", , "СправочникСсылка_Сотрудники_Справочник_Сотрудники");
	ДобавитьПКС(СвойстваШапки, "ФизическоеЛицо",                "ФизическоеЛицо", , "СправочникСсылка_ФизическиеЛица_Справочник_Физичес");
	ДобавитьПКС(СвойстваШапки, "ГрафикРаботы",                   "ГрафикРаботы", , "УСО2КД3_ГрафикиРаботы");
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "Начисления", "Начисления");
	ДобавитьПКС(СвойстваТЧ, "ИдентификаторСтрокиВидаРасчета", "ИдентификаторСтрокиВидаРасчета");
	ДобавитьПКС(СвойстваТЧ, "Начисление",                     "Начисление", , "УСО2КД3_Начисления");
	ДобавитьПКС(СвойстваТЧ, "Размер",                         "Размер");
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "Показатели", "Показатели");
	ДобавитьПКС(СвойстваТЧ, "Значение",                       "Значение");
	ДобавитьПКС(СвойстваТЧ, "ИдентификаторСтрокиВидаРасчета", "ИдентификаторСтрокиВидаРасчета");
	ДобавитьПКС(СвойстваТЧ, "Показатель",                     "Показатель", , "УСО2КД3_Показатели");

КонецПроцедуры

