#Область ПОД
// Заполняет таблицу правил обработки данных.
//
// Параметры:
//  НаправлениеОбмена - строка ("Отправка" либо "Получение").
//  ПравилаОбработкиДанных - таблица значений, в которую добавляются правила. 
Процедура ЗаполнитьПравилаОбработкиДанных(НаправлениеОбмена, ПравилаОбработкиДанных) Экспорт
	Если НаправлениеОбмена = "Получение" Тогда
		ДобавитьПОД_Получатель_ПОД_ПриемНаРаботу(ПравилаОбработкиДанных);
		ДобавитьПОД_Получатель_ПОД_Увольнение(ПравилаОбработкиДанных);
		ДобавитьПОД_Получатель_ПОД_КадровыйПеревод(ПравилаОбработкиДанных);
		ДобавитьПОД_Получатель_ПОД_КадровыйПереводСписком(ПравилаОбработкиДанных);
		ДобавитьПОД_Получатель_ПОД_УвольнениеСписком(ПравилаОбработкиДанных);
		ДобавитьПОД_Получатель_ПОД_ШтатноеРасписание(ПравилаОбработкиДанных);
	ИначеЕсли НаправлениеОбмена = "Отправка" Тогда
		// Обмен односторонний (ЗУП -> ERP): из ERP кадровые документы не отправляются.
		// ПОД без ПКО нужны, чтобы случайно зарегистрированные изменения/удаления этих документов
		// не обрывали отправку ошибкой «Не найдено ПОД для объекта метаданных».
		Для Каждого ИмяДокумента Из СтрРазделить("ПриемНаРаботу,Увольнение,КадровыйПеревод,КадровыйПереводСписком,УвольнениеСписком", ",") Цикл
			ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
			ПравилоОбработки.Имя                     = "УСО2КД3_НеОтправлять_" + ИмяДокумента;
			ПравилоОбработки.ОбъектВыборкиМетаданные = Метаданные.Документы[ИмяДокумента];
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

