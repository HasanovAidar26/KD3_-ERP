// Заполняет таблицу правил конвертации предопределенных данных.
//
// Параметры:
//  НаправлениеОбмена - строка ("Отправка" либо "Получение").
//  ПравилаКонвертации - таблица значений, в которую будут добавлены правила. 
Процедура ЗаполнитьПравилаКонвертацииПредопределенныхДанных(НаправлениеОбмена, ПравилаКонвертации) Экспорт
	Если НаправлениеОбмена = "Получение" Тогда
		// ВидыЗанятостиПолучениеЕРП.
		ПравилоКонвертации           = ПравилаКонвертации.Добавить();
		ПравилоКонвертации.ИмяПКПД   = "ВидыЗанятостиПолучениеЕРП";
		ПравилоКонвертации.ТипДанных = Метаданные.Перечисления.ВидыЗанятости;
		ПравилоКонвертации.ТипXDTO   = "ВидыЗанятости";
	
		ЗначенияДляПолучения = Новый Соответствие;
		ЗначенияДляПолучения.Вставить("ВнутреннееСовместительство", Перечисления.ВидыЗанятости.ВнутреннееСовместительство);
		ЗначенияДляПолучения.Вставить("ОсновноеМестоРаботы", Перечисления.ВидыЗанятости.ОсновноеМестоРаботы);
		ЗначенияДляПолучения.Вставить("Подработка", Перечисления.ВидыЗанятости.Подработка);
		ЗначенияДляПолучения.Вставить("Совместительство", Перечисления.ВидыЗанятости.Совместительство);
		ПравилоКонвертации.КонвертацииЗначенийПриПолучении = ЗначенияДляПолучения;
	КонецЕсли;
КонецПроцедуры

