Процедура ЗаполнитьПараметрыКонвертации(ПараметрыКонвертации) Экспорт
КонецПроцедуры

#КонецОбласти
#Область ОбщегоНазначения
// Процедура-обертка, выполняет запуск указанной в параметрах процедуры модуля менеджера обмена через формат.
//
// Параметры:
//  ИмяПроцедуры - строка.
//  СтруктураПараметров - структура, содержащая передаваемые параметры.
Процедура ВыполнитьПроцедуруМодуляМенеджера(ИмяПроцедуры, Параметры) Экспорт
	Если ИмяПроцедуры = "УСО2КД3_НеПерезаписыватьСуществующий" Тогда
		УСО2КД3_НеПерезаписыватьСуществующий(Параметры);
	ИначеЕсли ИмяПроцедуры = "УСО2КД3_ВидЗанятости_Получение" Тогда
		УСО2КД3_ВидЗанятости_Получение(Параметры);
	ИначеЕсли ИмяПроцедуры = "УСО2КД3_Увольнение_Получение" Тогда
		УСО2КД3_Увольнение_Получение(Параметры);
	ИначеЕсли ИмяПроцедуры = "УСО2КД3_КадровыйПеревод_Получение" Тогда
		УСО2КД3_КадровыйПеревод_Получение(Параметры);
	ИначеЕсли ИмяПроцедуры = "УСО2КД3_КадровыйПеревод_ПередЗаписью" Тогда
		УСО2КД3_КадровыйПеревод_ПередЗаписью(Параметры);
	ИначеЕсли ИмяПроцедуры = "УСО2КД3_КадровыйПереводСписком_Получение" Тогда
		УСО2КД3_КадровыйПереводСписком_Получение(Параметры);
	ИначеЕсли ИмяПроцедуры = "УСО2КД3_УвольнениеСписком_Получение" Тогда
		УСО2КД3_УвольнениеСписком_Получение(Параметры);
	ИначеЕсли ИмяПроцедуры = "УСО2КД3_ШтатноеРасписание_ПередЗаписью" Тогда
		УСО2КД3_ШтатноеРасписание_ПередЗаписью(Параметры);
	КонецЕсли;
КонецПроцедуры

// Получение: документ Увольнение (реквизиты расширенного namespace).
Процедура УСО2КД3_Увольнение_Получение(Параметры)

	// ДатаУвольнения (дата)
	ЗначДУ = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ДатаУвольнения", ЗначДУ) И ЗначениеЗаполнено(ЗначДУ) Тогда
		Попытка Параметры.ПолученныеДанные.ДатаУвольнения = ЗначДУ; Исключение КонецПопытки;
	КонецЕсли;

	// ОснованиеУвольнения (строка)
	ЗначОУ = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ОснованиеУвольнения", ЗначОУ) Тогда
		Попытка Параметры.ПолученныеДанные.ОснованиеУвольнения = Строка(ЗначОУ); Исключение КонецПопытки;
	КонецЕсли;

	// СтатьяТКРФ (ссылка ОснованияУвольнения) — резолв по Наименованию
	ЗначСТ = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("СтатьяТКРФ", ЗначСТ) Тогда
		ИмяСТ = СокрЛП(Строка(ЗначСТ));
		Если ЗначениеЗаполнено(ИмяСТ) Тогда
			НайдСТ = Справочники.ОснованияУвольнения.НайтиПоНаименованию(ИмяСТ, Истина);
			Если ЗначениеЗаполнено(НайдСТ) Тогда
				Параметры.ПолученныеДанные.СтатьяТКРФ = НайдСТ;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// ИсправленныйДокумент (ссылка на исправляемое Увольнение) — резолв по GUID
	ЗначИД = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ИсправленныйДокумент", ЗначИД) Тогда
		СтрГУИД = СокрЛП(Строка(ЗначИД));
		Если ЗначениеЗаполнено(СтрГУИД) Тогда
			Попытка
				Параметры.ПолученныеДанные.ИсправленныйДокумент = Документы.Увольнение.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрГУИД));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	// Прочие реквизиты (для проведения и совпадающие)
	Знач1 = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ПериодРегистрации", Знач1) И ЗначениеЗаполнено(Знач1) Тогда
		Попытка Параметры.ПолученныеДанные.ПериодРегистрации = Знач1; Исключение КонецПопытки;
	КонецЕсли;
	Знач2 = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("МесяцНачалаРасчетов", Знач2) И ЗначениеЗаполнено(Знач2) Тогда
		Попытка Параметры.ПолученныеДанные.МесяцНачалаРасчетов = Знач2; Исключение КонецПопытки;
	КонецЕсли;
	Знач3 = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("СреднемесячноеКоличествоДнейЧасов", Знач3) И ЗначениеЗаполнено(Знач3) Тогда
		Попытка Параметры.ПолученныеДанные.СреднемесячноеКоличествоДнейЧасов = Число(Знач3); Исключение КонецПопытки;
	КонецЕсли;
	Знач4 = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("КратностьВыходногоПособия", Знач4) И ЗначениеЗаполнено(Знач4) Тогда
		Попытка Параметры.ПолученныеДанные.КратностьВыходногоПособия = Число(Знач4); Исключение КонецПопытки;
	КонецЕсли;
	ЗначДК = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ДнейКомпенсацииУдержанияОтпуска", ЗначДК) И ЗначениеЗаполнено(ЗначДК) Тогда
		Попытка Параметры.ПолученныеДанные.ДнейКомпенсацииУдержанияОтпуска = Число(ЗначДК); Исключение КонецПопытки;
	КонецЕсли;
	ЗначПК = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ПризнакКомпенсацииУдержанияОтпуска", ЗначПК) Тогда
		ИмяПК = ?(ТипЗнч(ЗначПК) = Тип("Структура") И ЗначПК.Свойство("Значение"), Строка(ЗначПК.Значение), Строка(ЗначПК));
		Если ЗначениеЗаполнено(ИмяПК) Тогда
			Попытка Параметры.ПолученныеДанные.ПризнакКомпенсацииУдержанияОтпуска = XMLЗначение(Тип("ПеречислениеСсылка.КомпенсацияУдержаниеОтпускаПриУвольнении"), ИмяПК); Исключение КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	ЗначПВ = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ПорядокВыплаты", ЗначПВ) Тогда
		ИмяПВ = ?(ТипЗнч(ЗначПВ) = Тип("Структура") И ЗначПВ.Свойство("Значение"), Строка(ЗначПВ.Значение), Строка(ЗначПВ));
		Если ЗначениеЗаполнено(ИмяПВ) Тогда
			Попытка Параметры.ПолученныеДанные.ПорядокВыплаты = XMLЗначение(Тип("ПеречислениеСсылка.ХарактерВыплатыЗарплаты"), ИмяПВ); Исключение КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Знач5 = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ПланируемаяДатаВыплаты", Знач5) И ЗначениеЗаполнено(Знач5) Тогда
		Попытка Параметры.ПолученныеДанные.ПланируемаяДатаВыплаты = Знач5; Исключение КонецПопытки;
	КонецЕсли;
	Знач6 = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ОтразитьВТрудовойКнижке", Знач6) Тогда
		Попытка Параметры.ПолученныеДанные.ОтразитьВТрудовойКнижке = Булево(Знач6); Исключение КонецПопытки;
	КонецЕсли;
	Знач7 = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("НаименованиеДокумента", Знач7) Тогда
		Попытка Параметры.ПолученныеДанные.НаименованиеДокумента = Строка(Знач7); Исключение КонецПопытки;
	КонецЕсли;

	// Проведен — для штатного отложенного проведения
	ЗначПров = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("Проведен", ЗначПров) Тогда
		Попытка Параметры.ПолученныеДанные.Проведен = Булево(ЗначПров); Исключение КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Получение: документ КадровыйПеревод (реквизиты расширенного namespace).
Процедура УСО2КД3_КадровыйПеревод_Получение(Параметры)

	// --- ВидЗанятости (перечисление) ---
	ЗначВЗ = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ВидЗанятости", ЗначВЗ) Тогда
		ИмяВЗ = ?(ТипЗнч(ЗначВЗ) = Тип("Структура") И ЗначВЗ.Свойство("Значение"), Строка(ЗначВЗ.Значение), Строка(ЗначВЗ));
		Если ЗначениеЗаполнено(ИмяВЗ) Тогда
			Попытка Параметры.ПолученныеДанные.ВидЗанятости = XMLЗначение(Тип("ПеречислениеСсылка.ВидыЗанятости"), ИмяВЗ); Исключение КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	// --- ГрафикРаботы: GUID -> наименование -> график позиции штатного расписания ---
	ЗначГР = Неопределено;
	Параметры.ДанныеXDTO.Свойство("ГрафикРаботы", ЗначГР);
	НайдГР = УСО2КД3_НайтиГрафикРаботы(ЗначГР, Параметры.ПолученныеДанные.ДолжностьПоШтатномуРасписанию);
	Если ЗначениеЗаполнено(НайдГР) Тогда
		Параметры.ПолученныеДанные.ГрафикРаботы = НайдГР;
	КонецЕсли;

	// --- СпособРасчетаАванса (перечисление) — обязательный для проведения ---
	ЗначСА = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("СпособРасчетаАванса", ЗначСА) Тогда
		ИмяСА = ?(ТипЗнч(ЗначСА) = Тип("Структура") И ЗначСА.Свойство("Значение"), Строка(ЗначСА.Значение), Строка(ЗначСА));
		Если ЗначениеЗаполнено(ИмяСА) Тогда
			Попытка Параметры.ПолученныеДанные.СпособРасчетаАванса = XMLЗначение(Тип("ПеречислениеСсылка.СпособыРасчетаАванса"), ИмяСА); Исключение КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	// --- ВидДоговора (перечисление) — обязательный для проведения ---
	ЗначВД = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ВидДоговора", ЗначВД) Тогда
		ИмяВД = ?(ТипЗнч(ЗначВД) = Тип("Структура") И ЗначВД.Свойство("Значение"), Строка(ЗначВД.Значение), Строка(ЗначВД));
		Если ЗначениеЗаполнено(ИмяВД) Тогда
			Попытка Параметры.ПолученныеДанные.ВидДоговора = XMLЗначение(Тип("ПеречислениеСсылка.ВидыДоговоровССотрудниками"), ИмяВД); Исключение КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	// --- Булевы флаги (галка начислений + «Изменить...») ---
	УСО2КД3_ПрименитьБулево(Параметры, "НачисленияУтверждены");
	УСО2КД3_ПрименитьБулево(Параметры, "ИзменитьПодразделениеИДолжность");
	УСО2КД3_ПрименитьБулево(Параметры, "ИзменитьТерриторию");
	УСО2КД3_ПрименитьБулево(Параметры, "ИзменитьРабочееМесто");
	УСО2КД3_ПрименитьБулево(Параметры, "ИзменитьГрафикРаботы");
	УСО2КД3_ПрименитьБулево(Параметры, "ИзменитьНачисления");
	УСО2КД3_ПрименитьБулево(Параметры, "ИзменитьЕжегодныеОтпуска");
	УСО2КД3_ПрименитьБулево(Параметры, "ИзменитьВидЗанятости");
	УСО2КД3_ПрименитьБулево(Параметры, "ИзменитьАванс");
	УСО2КД3_ПрименитьБулево(Параметры, "ОтразитьВТрудовойКнижке");

	// --- Аванс (число) ---
	ЗначАв = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("Аванс", ЗначАв) И ЗначениеЗаполнено(ЗначАв) Тогда
		Попытка Параметры.ПолученныеДанные.Аванс = Число(ЗначАв); Исключение КонецПопытки;
	КонецЕсли;

	// --- НаименованиеДокумента (строка) ---
	ЗначНД = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("НаименованиеДокумента", ЗначНД) Тогда
		Попытка Параметры.ПолученныеДанные.НаименованиеДокумента = Строка(ЗначНД); Исключение КонецПопытки;
	КонецЕсли;

	// --- ИсправленныйДокумент (ссылка на исправляемый КадровыйПеревод) — резолв по GUID ---
	ЗначИД = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ИсправленныйДокумент", ЗначИД) Тогда
		СтрГУИД = СокрЛП(Строка(ЗначИД));
		Если ЗначениеЗаполнено(СтрГУИД) Тогда
			Попытка
				Параметры.ПолученныеДанные.ИсправленныйДокумент = Документы.КадровыйПеревод.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрГУИД));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	// --- Руководитель / ДолжностьРуководителя / ТрудоваяФункция — по наименованию ---
	УСО2КД3_УстановитьСсылкуПоНаименованию(Параметры, "Руководитель", Справочники.ФизическиеЛица);
	УСО2КД3_УстановитьСсылкуПоНаименованию(Параметры, "ДолжностьРуководителя", Справочники.Должности);
	УСО2КД3_УстановитьСсылкуПоНаименованию(Параметры, "ТрудоваяФункция", Справочники.ТрудовыеФункции);

	// --- Порядок пересчёта, совокупная тарифная ставка и её вид ---
	УСО2КД3_УстановитьПеречисление(Параметры, "ПорядокРасчетаСтоимостиЕдиницыВремени", "ПорядокРасчетаСтоимостиЕдиницыВремениОплатыТруда");
	УСО2КД3_УстановитьПеречисление(Параметры, "ВидТарифнойСтавки", "ВидыТарифныхСтавок");
	ЗначСТС = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("СовокупнаяТарифнаяСтавка", ЗначСТС) И ЗначениеЗаполнено(ЗначСТС) Тогда
		Попытка Параметры.ПолученныеДанные.СовокупнаяТарифнаяСтавка = Число(ЗначСТС); Исключение КонецПопытки;
	КонецЕсли;

	// --- Проведен: помечаем документ проведённым для штатной очереди отложенного проведения ---
	ЗначПров = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("Проведен", ЗначПров) Тогда
		Попытка Параметры.ПолученныеДанные.Проведен = Булево(ЗначПров); Исключение КонецПопытки;
	КонецЕсли;

	// --- Начисления (ТЧ): ссылка Начисление + Размер + ИдентификаторСтрокиВидаРасчета ---
	ЗначНач = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("Начисления", ЗначНач) И ТипЗнч(ЗначНач) = Тип("ТаблицаЗначений") Тогда
		ТЧДок = Параметры.ПолученныеДанные.Начисления;
		ЕстьКолНач = Не (ЗначНач.Колонки.Найти("Начисление") = Неопределено);
		ЕстьКолРазм = Не (ЗначНач.Колонки.Найти("Размер") = Неопределено);
		ЕстьКолИд = Не (ЗначНач.Колонки.Найти("ИдентификаторСтрокиВидаРасчета") = Неопределено);
		ЕстьКолДейств = Не (ЗначНач.Колонки.Найти("Действие") = Неопределено);
		ЕстьКолКат = Не (ЗначНач.Колонки.Найти("КатегорияНачисления") = Неопределено);
		Инд = 0;
		Для Каждого СтрИст Из ЗначНач Цикл
			Если Инд >= ТЧДок.Количество() Тогда Прервать; КонецЕсли;
			СтрДок = ТЧДок[Инд];
			Если ЕстьКолНач Тогда
				// Сначала по GUID (в ЗУП бывают разные начисления с одинаковым наименованием), затем по наименованию.
				НайдН = УСО2КД3_НайтиНачисление(СтрИст.Начисление, ?(ЕстьКолКат, СтрИст.КатегорияНачисления, ""));
				Если ЗначениеЗаполнено(НайдН) Тогда
					СтрДок.Начисление = НайдН;
				КонецЕсли;
			КонецЕсли;
			Если ЕстьКолРазм Тогда
				Попытка СтрДок.Размер = Число(СтрИст.Размер); Исключение КонецПопытки;
			КонецЕсли;
			Если ЕстьКолИд Тогда
				Попытка СтрДок.ИдентификаторСтрокиВидаРасчета = СтрИст.ИдентификаторСтрокиВидаРасчета; Исключение КонецПопытки;
			КонецЕсли;
			// Действие (Утвердить/Отменить): без него отменяемое и новое начисление
			// загружаются одинаковыми строками и перевод в ERP не проводится.
			Если ЕстьКолДейств Тогда
				УСО2КД3_УстановитьДействие(СтрДок, СтрИст.Действие);
			КонецЕсли;
			Инд = Инд + 1;
		КонецЦикла;
	КонецЕсли;

	// --- Показатели (ТЧ): ссылка Показатель + Значение + ИдентификаторСтрокиВидаРасчета ---
	ЗначПок = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("Показатели", ЗначПок) И ТипЗнч(ЗначПок) = Тип("ТаблицаЗначений") Тогда
		ТЧПок = Параметры.ПолученныеДанные.Показатели;
		ЕстьКолПок = Не (ЗначПок.Колонки.Найти("Показатель") = Неопределено);
		ЕстьКолЗнач = Не (ЗначПок.Колонки.Найти("Значение") = Неопределено);
		ЕстьКолИдП = Не (ЗначПок.Колонки.Найти("ИдентификаторСтрокиВидаРасчета") = Неопределено);
		ЕстьКолДействП = Не (ЗначПок.Колонки.Найти("Действие") = Неопределено);
		ЕстьКолПредопр = Не (ЗначПок.Колонки.Найти("ПредопределенныйПоказатель") = Неопределено);
		ИндП = 0;
		Для Каждого СтрИстП Из ЗначПок Цикл
			Если ИндП >= ТЧПок.Количество() Тогда Прервать; КонецЕсли;
			СтрДокП = ТЧПок[ИндП];
			Если ЕстьКолПок Тогда
				НайдП = УСО2КД3_НайтиПоказатель(СтрИстП.Показатель, ?(ЕстьКолПредопр, СтрИстП.ПредопределенныйПоказатель, ""));
				Если ЗначениеЗаполнено(НайдП) Тогда
					СтрДокП.Показатель = НайдП;
				КонецЕсли;
			КонецЕсли;
			Если ЕстьКолЗнач Тогда
				Попытка
					СтрДокП.Значение = Число(СтрИстП.Значение);
				Исключение
					Попытка СтрДокП.Значение = СтрИстП.Значение; Исключение КонецПопытки;
				КонецПопытки;
			КонецЕсли;
			Если ЕстьКолИдП Тогда
				Попытка СтрДокП.ИдентификаторСтрокиВидаРасчета = СтрИстП.ИдентификаторСтрокиВидаРасчета; Исключение КонецПопытки;
			КонецЕсли;
			Если ЕстьКолДействП Тогда
				УСО2КД3_УстановитьДействие(СтрДокП, СтрИстП.Действие);
			КонецЕсли;
			ИндП = ИндП + 1;
		КонецЦикла;
	КонецЕсли;


	// Если отменяемое и новое начисление в ERP оказались одним видом расчета —
	// убираем строку «Отменить» (иначе «Заданы одинаковые начисления» при проведении).
	УСО2КД3_УбратьОтменуПовторногоНачисления(Параметры.ПолученныеДанные);

КонецПроцедуры

// Получение (ПередЗаписью): оплата труда документа — суммы из позиции ШР.
// На этой стадии зависимости (позиция ШР) уже записаны, поэтому начисления ШР доступны.
Процедура УСО2КД3_КадровыйПеревод_ПередЗаписью(Параметры)
	Если Параметры.ПолученныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	УСО2КД3_ЗаполнитьОплатуДокументаИзШР(Параметры.ПолученныеДанные);
КонецПроцедуры

// Заполняет оплату труда документа из позиции ШР (ДолжностьПоШтатномуРасписанию):
// ПОЛНОСТЬЮ заменяет ТЧ Начисления и Показатели документа начислениями/показателями позиции ШР
// (ERP — источник истины по ФОТ). Новым строкам ставим Действие=Утвердить, ставим флаг
// «Изменить начисления». Связка начисление<->показатель сохраняется через ИдентификаторСтрокиВидаРасчета.
// Если у позиции ШР начислений нет — состав документа не трогаем.
Процедура УСО2КД3_ЗаполнитьОплатуДокументаИзШР(Документ)
	Попытка
		Позиция = Документ.ДолжностьПоШтатномуРасписанию;
		Если НЕ ЗначениеЗаполнено(Позиция) Тогда
			Возврат;
		КонецЕсли;
		НачисленияШР = Позиция.Начисления.Выгрузить();
		Если НачисленияШР.Количество() = 0 Тогда
			Попытка
				ЗаписьЖурналаРегистрации("УСО2КД3.ШР", УровеньЖурналаРегистрации.Информация, , Документ.Ссылка,
					"Оплата документа из ШР """ + Строка(Позиция) + """: в позиции ШР нет начислений — состав документа не изменён");
			Исключение
			КонецПопытки;
			Возврат;
		КонецЕсли;
		ПоказателиШР = Позиция.Показатели.Выгрузить();
		Утвердить = Перечисления.ДействияСНачислениямиИУдержаниями.Утвердить;

		Документ.Начисления.Очистить();
		Для Каждого СтрШР Из НачисленияШР Цикл
			НоваяСтр = Документ.Начисления.Добавить();
			НоваяСтр.Начисление = СтрШР.Начисление;
			Попытка НоваяСтр.Размер = СтрШР.Размер; Исключение КонецПопытки;
			Попытка НоваяСтр.ИдентификаторСтрокиВидаРасчета = СтрШР.ИдентификаторСтрокиВидаРасчета; Исключение КонецПопытки;
			Попытка НоваяСтр.Действие = Утвердить; Исключение КонецПопытки;
		КонецЦикла;

		Документ.Показатели.Очистить();
		Для Каждого СтрШР Из ПоказателиШР Цикл
			НоваяСтр = Документ.Показатели.Добавить();
			НоваяСтр.Показатель = СтрШР.Показатель;
			Попытка НоваяСтр.Значение = СтрШР.Значение; Исключение КонецПопытки;
			Попытка НоваяСтр.ИдентификаторСтрокиВидаРасчета = СтрШР.ИдентификаторСтрокиВидаРасчета; Исключение КонецПопытки;
			Попытка НоваяСтр.Действие = Утвердить; Исключение КонецПопытки;
		КонецЦикла;

		Попытка Документ.ИзменитьНачисления = Истина; Исключение КонецПопытки;

		Попытка
			ЗаписьЖурналаРегистрации("УСО2КД3.ШР", УровеньЖурналаРегистрации.Информация, , Документ.Ссылка,
				"Оплата документа из ШР """ + Строка(Позиция) + """: начислений="
				+ Строка(Документ.Начисления.Количество()) + ", показателей=" + Строка(Документ.Показатели.Количество()));
		Исключение
		КонецПопытки;
	Исключение
		УСО2КД3_ЛогОшибкиШР("оплата документа из ШР");
	КонецПопытки;
КонецПроцедуры

// Ищет элемент по GUID из ключевых свойств XDTO, если не найден — по наименованию.
Функция УСО2КД3_НайтиПоСсылкеИлиНаименованию(ЗначениеXDTO, Менеджер)
	Если ТипЗнч(ЗначениеXDTO) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЗначСсылка = Неопределено;
	Если ЗначениеXDTO.Свойство("Ссылка", ЗначСсылка) И ЗначениеЗаполнено(ЗначСсылка) Тогда
		Если ТипЗнч(ЗначСсылка) = Тип("Структура") И ЗначСсылка.Свойство("Значение") Тогда
			ЗначСсылка = ЗначСсылка.Значение;
		КонецЕсли;
		Попытка
			НайдСсылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Строка(ЗначСсылка))));
			Если ОбщегоНазначения.СсылкаСуществует(НайдСсылка) Тогда
				Возврат НайдСсылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	ИмяЭлемента = "";
	Если ЗначениеXDTO.Свойство("Наименование") Тогда
		ИмяЭлемента = СокрЛП(Строка(ЗначениеXDTO.Наименование));
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяЭлемента) Тогда
		НайдСсылка = Менеджер.НайтиПоНаименованию(ИмяЭлемента, Истина);
		Если ЗначениеЗаполнено(НайдСсылка) Тогда
			Возврат НайдСсылка;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Устанавливает Действие (ДействияСНачислениямиИУдержаниями) строки ТЧ из строки формата.
Процедура УСО2КД3_УстановитьДействие(СтрокаТЧ, ЗначениеДействия)
	ИмяДействия = ?(ТипЗнч(ЗначениеДействия) = Тип("Структура") И ЗначениеДействия.Свойство("Значение"),
		Строка(ЗначениеДействия.Значение), СокрЛП(Строка(ЗначениеДействия)));
	Если ЗначениеЗаполнено(ИмяДействия) Тогда
		Попытка
			СтрокаТЧ.Действие = XMLЗначение(Тип("ПеречислениеСсылка.ДействияСНачислениямиИУдержаниями"), ИмяДействия);
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// В ЗУП оклад может меняться отменой одного вида расчета и утверждением другого.
// Если в ERP оба сопоставились с одним начислением, строка «Отменить» лишняя:
// удаляем её вместе с показателями — остаётся утверждение нового размера.
Процедура УСО2КД3_УбратьОтменуПовторногоНачисления(Документ)
	ЕстьСотрудник = (Документ.Метаданные().ТабличныеЧасти.Начисления.Реквизиты.Найти("ИдентификаторСтрокиСотрудника") <> Неопределено);
	Отменить = Перечисления.ДействияСНачислениямиИУдержаниями.Отменить;
	УдаляемыеСтроки = Новый Массив;
	Для Каждого СтрокаОтмены Из Документ.Начисления Цикл
		Если СтрокаОтмены.Действие <> Отменить Или Не ЗначениеЗаполнено(СтрокаОтмены.Начисление) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаУтв Из Документ.Начисления Цикл
			Если СтрокаУтв <> СтрокаОтмены
				И СтрокаУтв.Начисление = СтрокаОтмены.Начисление
				И СтрокаУтв.Действие <> Отменить
				И (Не ЕстьСотрудник Или СтрокаУтв.ИдентификаторСтрокиСотрудника = СтрокаОтмены.ИдентификаторСтрокиСотрудника) Тогда
				УдаляемыеСтроки.Добавить(СтрокаОтмены);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Каждого СтрокаОтмены Из УдаляемыеСтроки Цикл
		Отбор = Новый Структура("ИдентификаторСтрокиВидаРасчета", СтрокаОтмены.ИдентификаторСтрокиВидаРасчета);
		Если ЕстьСотрудник Тогда
			Отбор.Вставить("ИдентификаторСтрокиСотрудника", СтрокаОтмены.ИдентификаторСтрокиСотрудника);
		КонецЕсли;
		Для Каждого СтрокаПоказателя Из Документ.Показатели.НайтиСтроки(Отбор) Цикл
			Документ.Показатели.Удалить(СтрокаПоказателя);
		КонецЦикла;
		Документ.Начисления.Удалить(СтрокаОтмены);
	КонецЦикла;
КонецПроцедуры

// Начисление: по GUID (если категория совпадает), затем по категории + наименованию,
// затем единственное начисление категории (районный коэффициент и т.п.), затем по наименованию.
Функция УСО2КД3_НайтиНачисление(ЗначениеXDTO, ИмяКатегории)
	Категория = Неопределено;
	Если ЗначениеЗаполнено(ИмяКатегории) Тогда
		Попытка
			Категория = XMLЗначение(Тип("ПеречислениеСсылка.КатегорииНачисленийИНеоплаченногоВремени"), СокрЛП(Строка(ИмяКатегории)));
		Исключение
			Категория = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если Категория = Неопределено Тогда
		Возврат УСО2КД3_НайтиПоСсылкеИлиНаименованию(ЗначениеXDTO, ПланыВидовРасчета.Начисления);
	КонецЕсли;

	ПоСсылке = УСО2КД3_НайтиПоСсылкеИлиНаименованию(
		Новый Структура("Ссылка", ?(ТипЗнч(ЗначениеXDTO) = Тип("Структура") И ЗначениеXDTO.Свойство("Ссылка"), ЗначениеXDTO.Ссылка, Неопределено)),
		ПланыВидовРасчета.Начисления);
	Если ЗначениеЗаполнено(ПоСсылке)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоСсылке, "КатегорияНачисленияИлиНеоплаченногоВремени") = Категория Тогда
		Возврат ПоСсылке;
	КонецЕсли;

	ИмяЭлемента = "";
	Если ТипЗнч(ЗначениеXDTO) = Тип("Структура") И ЗначениеXDTO.Свойство("Наименование") Тогда
		ИмяЭлемента = СокрЛП(Строка(ЗначениеXDTO.Наименование));
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Начисления.Ссылка КАК Ссылка,
	|	Начисления.Наименование КАК Наименование
	|ИЗ
	|	ПланВидовРасчета.Начисления КАК Начисления
	|ГДЕ
	|	НЕ Начисления.ПометкаУдаления
	|	И Начисления.КатегорияНачисленияИлиНеоплаченногоВремени = &Категория");
	Запрос.УстановитьПараметр("Категория", Категория);
	Выборка = Запрос.Выполнить().Выбрать();
	Единственное = Неопределено;
	Количество = 0;
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(ИмяЭлемента) И ВРег(СокрЛП(Выборка.Наименование)) = ВРег(ИмяЭлемента) Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		Единственное = Выборка.Ссылка;
		Количество = Количество + 1;
	КонецЦикла;
	Если Количество = 1 Тогда
		Возврат Единственное;
	КонецЕсли;

	Возврат УСО2КД3_НайтиПоСсылкеИлиНаименованию(ЗначениеXDTO, ПланыВидовРасчета.Начисления);
КонецФункции

// Показатель: по GUID, затем предопределённый по имени (РайонныйКоэффициент и т.п.), затем по наименованию.
Функция УСО2КД3_НайтиПоказатель(ЗначениеXDTO, ИмяПредопределенного)
	Если ЗначениеЗаполнено(ИмяПредопределенного) Тогда
		Попытка
			Предопр = ПредопределенноеЗначение("Справочник.ПоказателиРасчетаЗарплаты." + СокрЛП(Строка(ИмяПредопределенного)));
			Если ЗначениеЗаполнено(Предопр) Тогда
				Возврат Предопр;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат УСО2КД3_НайтиПоСсылкеИлиНаименованию(ЗначениеXDTO, Справочники.ПоказателиРасчетаЗарплаты);
КонецФункции

// Ссылочный реквизит, переданный строкой-наименованием.
Процедура УСО2КД3_УстановитьСсылкуПоНаименованию(Параметры, ИмяРеквизита, Менеджер)
	Значение = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство(ИмяРеквизита, Значение) Тогда
		ИмяЭлемента = СокрЛП(Строка(Значение));
		Если ЗначениеЗаполнено(ИмяЭлемента) Тогда
			Найд = Менеджер.НайтиПоНаименованию(ИмяЭлемента, Истина);
			Если ЗначениеЗаполнено(Найд) Тогда
				Параметры.ПолученныеДанные[ИмяРеквизита] = Найд;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Реквизит-перечисление, переданный строкой (XML-имя значения).
Процедура УСО2КД3_УстановитьПеречисление(Параметры, ИмяРеквизита, ИмяПеречисления)
	Значение = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство(ИмяРеквизита, Значение) Тогда
		ИмяЗначения = ?(ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("Значение"), Строка(Значение.Значение), СокрЛП(Строка(Значение)));
		Если ЗначениеЗаполнено(ИмяЗначения) Тогда
			Попытка
				Параметры.ПолученныеДанные[ИмяРеквизита] = XMLЗначение(Тип("ПеречислениеСсылка." + ИмяПеречисления), ИмяЗначения);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Получение: КадровыйПереводСписком. Строки ТЧ формата идут в том же порядке, что и строки документа
// после конвертации ПКТЧ, поэтому дозаполняем по индексу.
Процедура УСО2КД3_КадровыйПереводСписком_Получение(Параметры)
	ДанныеXDTO = Параметры.ДанныеXDTO;
	Документ = Параметры.ПолученныеДанные;

	// --- Шапка ---
	УСО2КД3_УстановитьПеречисление(Параметры, "ВидДоговора", "ВидыДоговоровССотрудниками");
	УСО2КД3_УстановитьСсылкуПоНаименованию(Параметры, "Руководитель", Справочники.ФизическиеЛица);
	УСО2КД3_УстановитьСсылкуПоНаименованию(Параметры, "ДолжностьРуководителя", Справочники.Должности);
	УСО2КД3_ПрименитьБулево(Параметры, "НачисленияУтверждены");
	ЗначИД = Неопределено;
	Если ДанныеXDTO.Свойство("ИсправленныйДокумент", ЗначИД) И ЗначениеЗаполнено(ЗначИД) Тогда
		Попытка
			Документ.ИсправленныйДокумент = Документы.КадровыйПереводСписком.ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Строка(ЗначИД))));
		Исключение
		КонецПопытки;
	КонецЕсли;
	ЗначПров = Неопределено;
	Если ДанныеXDTO.Свойство("Проведен", ЗначПров) Тогда
		Попытка Документ.Проведен = Булево(ЗначПров); Исключение КонецПопытки;
	КонецЕсли;

	// --- ТЧ Сотрудники ---
	ТЧ = Неопределено;
	Если ДанныеXDTO.Свойство("Сотрудники", ТЧ) И ТипЗнч(ТЧ) = Тип("ТаблицаЗначений") Тогда
		Перечисления_ = Новый Соответствие;
		Перечисления_.Вставить("ВидЗанятости", "ВидыЗанятости");
		Перечисления_.Вставить("СпособРасчетаАванса", "СпособыРасчетаАванса");
		Перечисления_.Вставить("ПорядокРасчетаСтоимостиЕдиницыВремени", "ПорядокРасчетаСтоимостиЕдиницыВремениОплатыТруда");
		Перечисления_.Вставить("ВидТарифнойСтавки", "ВидыТарифныхСтавок");
		Для Инд = 0 По Мин(ТЧ.Количество(), Документ.Сотрудники.Количество()) - 1 Цикл
			СтрИст = ТЧ[Инд];
			СтрДок = Документ.Сотрудники[Инд];
			Для Каждого КлючИЗначение Из Перечисления_ Цикл
				Если ТЧ.Колонки.Найти(КлючИЗначение.Ключ) <> Неопределено Тогда
					ЗначПер = УСО2КД3_ЗначениеПеречисления(СтрИст[КлючИЗначение.Ключ], КлючИЗначение.Значение);
					Если ЗначПер <> Неопределено Тогда
						СтрДок[КлючИЗначение.Ключ] = ЗначПер;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если ТЧ.Колонки.Найти("ТрудоваяФункция") <> Неопределено И ЗначениеЗаполнено(СтрИст.ТрудоваяФункция) Тогда
				НайдТФ = Справочники.ТрудовыеФункции.НайтиПоНаименованию(СокрЛП(Строка(СтрИст.ТрудоваяФункция)), Истина);
				Если ЗначениеЗаполнено(НайдТФ) Тогда
					СтрДок.ТрудоваяФункция = НайдТФ;
				КонецЕсли;
			КонецЕсли;
			Если ТЧ.Колонки.Найти("СовокупнаяТарифнаяСтавка") <> Неопределено И ЗначениеЗаполнено(СтрИст.СовокупнаяТарифнаяСтавка) Тогда
				Попытка СтрДок.СовокупнаяТарифнаяСтавка = Число(СтрИст.СовокупнаяТарифнаяСтавка); Исключение КонецПопытки;
			КонецЕсли;
			НайдГР = УСО2КД3_НайтиГрафикРаботы(?(ТЧ.Колонки.Найти("ГрафикРаботы") <> Неопределено, СтрИст.ГрафикРаботы, Неопределено),
				СтрДок.ДолжностьПоШтатномуРасписанию);
			Если ЗначениеЗаполнено(НайдГР) Тогда
				СтрДок.ГрафикРаботы = НайдГР;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// --- ТЧ Начисления: вид расчета (GUID/категория/наименование) + Действие ---
	Если ДанныеXDTO.Свойство("Начисления", ТЧ) И ТипЗнч(ТЧ) = Тип("ТаблицаЗначений") Тогда
		ЕстьКат = ТЧ.Колонки.Найти("КатегорияНачисления") <> Неопределено;
		ЕстьДейств = ТЧ.Колонки.Найти("Действие") <> Неопределено;
		ЕстьНач = ТЧ.Колонки.Найти("Начисление") <> Неопределено;
		Для Инд = 0 По Мин(ТЧ.Количество(), Документ.Начисления.Количество()) - 1 Цикл
			СтрИст = ТЧ[Инд];
			СтрДок = Документ.Начисления[Инд];
			Если ЕстьНач Тогда
				НайдН = УСО2КД3_НайтиНачисление(СтрИст.Начисление, ?(ЕстьКат, СтрИст.КатегорияНачисления, ""));
				Если ЗначениеЗаполнено(НайдН) Тогда
					СтрДок.Начисление = НайдН;
				КонецЕсли;
			КонецЕсли;
			Если ЕстьДейств Тогда
				УСО2КД3_УстановитьДействие(СтрДок, СтрИст.Действие);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// --- ТЧ Показатели ---
	Если ДанныеXDTO.Свойство("Показатели", ТЧ) И ТипЗнч(ТЧ) = Тип("ТаблицаЗначений") Тогда
		ЕстьПредопр = ТЧ.Колонки.Найти("ПредопределенныйПоказатель") <> Неопределено;
		ЕстьДейств = ТЧ.Колонки.Найти("Действие") <> Неопределено;
		ЕстьПок = ТЧ.Колонки.Найти("Показатель") <> Неопределено;
		Для Инд = 0 По Мин(ТЧ.Количество(), Документ.Показатели.Количество()) - 1 Цикл
			СтрИст = ТЧ[Инд];
			СтрДок = Документ.Показатели[Инд];
			Если ЕстьПок Тогда
				НайдП = УСО2КД3_НайтиПоказатель(СтрИст.Показатель, ?(ЕстьПредопр, СтрИст.ПредопределенныйПоказатель, ""));
				Если ЗначениеЗаполнено(НайдП) Тогда
					СтрДок.Показатель = НайдП;
				КонецЕсли;
			КонецЕсли;
			Если ЕстьДейств Тогда
				УСО2КД3_УстановитьДействие(СтрДок, СтрИст.Действие);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	УСО2КД3_УбратьОтменуПовторногоНачисления(Документ);
КонецПроцедуры

// Значение перечисления по XML-имени (строка или структура {Значение}); Неопределено, если не распознано.
Функция УСО2КД3_ЗначениеПеречисления(Значение, ИмяПеречисления)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяЗначения = ?(ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("Значение"), Строка(Значение.Значение), СокрЛП(Строка(Значение)));
	Если Не ЗначениеЗаполнено(ИмяЗначения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("ПеречислениеСсылка." + ИмяПеречисления), ИмяЗначения);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Получение: УвольнениеСписком. Строки ТЧ Сотрудники формата и документа совпадают по порядку.
Процедура УСО2КД3_УвольнениеСписком_Получение(Параметры)
	ДанныеXDTO = Параметры.ДанныеXDTO;
	Документ = Параметры.ПолученныеДанные;

	УСО2КД3_УстановитьПеречисление(Параметры, "ПорядокВыплаты", "ХарактерВыплатыЗарплаты");
	УСО2КД3_УстановитьСсылкуПоНаименованию(Параметры, "Руководитель", Справочники.ФизическиеЛица);
	УСО2КД3_УстановитьСсылкуПоНаименованию(Параметры, "ДолжностьРуководителя", Справочники.Должности);
	ЗначИД = Неопределено;
	Если ДанныеXDTO.Свойство("ИсправленныйДокумент", ЗначИД) И ЗначениеЗаполнено(ЗначИД) Тогда
		Попытка
			Документ.ИсправленныйДокумент = Документы.УвольнениеСписком.ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Строка(ЗначИД))));
		Исключение
		КонецПопытки;
	КонецЕсли;
	ЗначПров = Неопределено;
	Если ДанныеXDTO.Свойство("Проведен", ЗначПров) Тогда
		Попытка Документ.Проведен = Булево(ЗначПров); Исключение КонецПопытки;
	КонецЕсли;

	ТЧ = Неопределено;
	Если Не ДанныеXDTO.Свойство("Сотрудники", ТЧ) Или ТипЗнч(ТЧ) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	Для Инд = 0 По Мин(ТЧ.Количество(), Документ.Сотрудники.Количество()) - 1 Цикл
		СтрИст = ТЧ[Инд];
		СтрДок = Документ.Сотрудники[Инд];

		// Статья ТК РФ — по наименованию (типовые, затем пользовательские основания)
		ИмяСтатьи = УСО2КД3_СтрокаКолонки(ТЧ, СтрИст, "СтатьяТКРФ");
		Если ЗначениеЗаполнено(ИмяСтатьи) Тогда
			НайдСт = Справочники.ОснованияУвольнения.НайтиПоНаименованию(ИмяСтатьи, Истина);
			Если Не ЗначениеЗаполнено(НайдСт) Тогда
				НайдСт = Справочники.ОснованияУвольненияПользовательские.НайтиПоНаименованию(ИмяСтатьи, Истина);
			КонецЕсли;
			Если ЗначениеЗаполнено(НайдСт) Тогда
				СтрДок.СтатьяТКРФ = НайдСт;
			КонецЕсли;
		КонецЕсли;

		Если ТЧ.Колонки.Найти("ПризнакКомпенсацииУдержанияОтпуска") <> Неопределено Тогда
			ЗначПер = УСО2КД3_ЗначениеПеречисления(СтрИст.ПризнакКомпенсацииУдержанияОтпуска, "КомпенсацияУдержаниеОтпускаПриУвольнении");
			Если ЗначПер <> Неопределено Тогда
				СтрДок.ПризнакКомпенсацииУдержанияОтпуска = ЗначПер;
			КонецЕсли;
		КонецЕсли;

		// Вид расчета компенсации/удержания отпуска: начисление (по категории/наименованию) или удержание (по наименованию)
		ИмяВР = УСО2КД3_СтрокаКолонки(ТЧ, СтрИст, "ВидРасчетаКомпенсацииУдержанияОтпуска");
		Если ЗначениеЗаполнено(ИмяВР) Тогда
			Если УСО2КД3_СтрокаКолонки(ТЧ, СтрИст, "ВидРасчетаКомпенсацииУдержанияОтпускаТип") = "Удержания" Тогда
				НайдВР = ПланыВидовРасчета.Удержания.НайтиПоНаименованию(ИмяВР, Истина);
			Иначе
				НайдВР = УСО2КД3_НайтиНачисление(Новый Структура("Наименование", ИмяВР),
					УСО2КД3_СтрокаКолонки(ТЧ, СтрИст, "ВидРасчетаКомпенсацииУдержанияОтпускаКатегория"));
			КонецЕсли;
			Если ЗначениеЗаполнено(НайдВР) Тогда
				СтрДок.ВидРасчетаКомпенсацииУдержанияОтпуска = НайдВР;
			КонецЕсли;
		КонецЕсли;

		// Выходное пособие (начисление)
		ИмяВП = УСО2КД3_СтрокаКолонки(ТЧ, СтрИст, "ВыходноеПособие");
		Если ЗначениеЗаполнено(ИмяВП) Тогда
			НайдВП = УСО2КД3_НайтиНачисление(Новый Структура("Наименование", ИмяВП),
				УСО2КД3_СтрокаКолонки(ТЧ, СтрИст, "ВыходноеПособиеКатегория"));
			Если ЗначениеЗаполнено(НайдВП) Тогда
				СтрДок.ВыходноеПособие = НайдВП;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Строковое значение колонки строки ТЧ формата ("" если колонки нет или значение пустое).
Функция УСО2КД3_СтрокаКолонки(ТЧ, СтрокаТЧ, ИмяКолонки)
	Если ТЧ.Колонки.Найти(ИмяКолонки) = Неопределено Или СтрокаТЧ[ИмяКолонки] = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(СтрокаТЧ[ИмяКолонки]));
КонецФункции

// График работы: по GUID из ЗУП (если такой график есть в ERP), затем по наименованию,
// затем — график позиции штатного расписания ERP. Неопределено, если ничего не найдено.
Функция УСО2КД3_НайтиГрафикРаботы(ЗначениеXDTO, ПозицияШР)
	Если ТипЗнч(ЗначениеXDTO) = Тип("Структура") Тогда
		НайдГР = УСО2КД3_НайтиПоСсылкеИлиНаименованию(ЗначениеXDTO, Справочники.ГрафикиРаботыСотрудников);
		Если ЗначениеЗаполнено(НайдГР) Тогда
			Возврат НайдГР;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПозицияШР) Тогда
		Попытка
			ГрафикПозиции = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПозицияШР, "ГрафикРаботыСотрудников");
			Если ТипЗнч(ГрафикПозиции) = Тип("СправочникСсылка.ГрафикиРаботыСотрудников") И ЗначениеЗаполнено(ГрафикПозиции) Тогда
				Возврат ГрафикПозиции;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// График не найден и не выведен из позиции ШР — создаём стаб по наименованию
	// (с GUID источника, чтобы следующие обмены находили его по ссылке; расписание дозаполняется в ERP вручную).
	НайдСтаб = УСО2КД3_СоздатьСтабГрафика(ЗначениеXDTO);
	Если ЗначениеЗаполнено(НайдСтаб) Тогда
		Возврат НайдСтаб;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Создаёт стаб графика работы по данным XDTO (Наименование + Ссылка/GUID источника), если наименование задано.
Функция УСО2КД3_СоздатьСтабГрафика(ЗначениеXDTO)
	Если ТипЗнч(ЗначениеXDTO) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяГР = "";
	Если ЗначениеXDTO.Свойство("Наименование") Тогда
		ИмяГР = СокрЛП(Строка(ЗначениеXDTO.Наименование));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ИмяГР) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		НовыйГР = Справочники.ГрафикиРаботыСотрудников.СоздатьЭлемент();
		ЗначСсылка = Неопределено;
		Если ЗначениеXDTO.Свойство("Ссылка", ЗначСсылка) И ЗначениеЗаполнено(ЗначСсылка) Тогда
			Если ТипЗнч(ЗначСсылка) = Тип("Структура") И ЗначСсылка.Свойство("Значение") Тогда
				ЗначСсылка = ЗначСсылка.Значение;
			КонецЕсли;
			Попытка
				НовыйГР.УстановитьСсылкуНового(Справочники.ГрафикиРаботыСотрудников.ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Строка(ЗначСсылка)))));
			Исключение
			КонецПопытки;
		КонецЕсли;
		НовыйГР.Наименование = ИмяГР;
		НовыйГР.Записать();
		Возврат НовыйГР.Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Применяет булев реквизит расширенного namespace к полученному документу (если пришёл).
Процедура УСО2КД3_ПрименитьБулево(Параметры, ИмяРеквизита)
	ЗначБ = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство(ИмяРеквизита, ЗначБ) Тогда
		Попытка Параметры.ПолученныеДанные[ИмяРеквизита] = Булево(ЗначБ); Исключение КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Получение: вид занятости (строка расширения формата -> перечисление ERP).
Процедура УСО2КД3_ВидЗанятости_Получение(Параметры)

	// --- ВидЗанятости (перечисление в расширенном namespace) ---
	ЗначВЗ = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ВидЗанятости", ЗначВЗ) Тогда
		Если ТипЗнч(ЗначВЗ) = Тип("Структура") И ЗначВЗ.Свойство("Значение") Тогда
			ИмяЗначения = Строка(ЗначВЗ.Значение);
		Иначе
			ИмяЗначения = Строка(ЗначВЗ);
		КонецЕсли;
		Если ЗначениеЗаполнено(ИмяЗначения) Тогда
			Параметры.ПолученныеДанные.ВидЗанятости = XMLЗначение(Тип("ПеречислениеСсылка.ВидыЗанятости"), ИмяЗначения);
		КонецЕсли;
	КонецЕсли;

	// --- ГрафикРаботы: GUID -> наименование -> график позиции штатного расписания ---
	ЗначГР = Неопределено;
	Параметры.ДанныеXDTO.Свойство("ГрафикРаботы", ЗначГР);
	НайдГР = УСО2КД3_НайтиГрафикРаботы(ЗначГР, Параметры.ПолученныеДанные.ДолжностьПоШтатномуРасписанию);
	Если ЗначениеЗаполнено(НайдГР) Тогда
		Параметры.ПолученныеДанные.ГрафикРаботы = НайдГР;
	КонецЕсли;

	// --- ДлительностьИспытательногоСрока (число) ---
	ЗначИС = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ДлительностьИспытательногоСрока", ЗначИС) И ЗначениеЗаполнено(ЗначИС) Тогда
		Попытка
			Параметры.ПолученныеДанные.ДлительностьИспытательногоСрока = Число(ЗначИС);
		Исключение
		КонецПопытки;
	КонецЕсли;

	// --- Руководитель (ссылка ФизическиеЛица) — резолв по ФИО (Наименованию) ---
	ЗначРук = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("Руководитель", ЗначРук) Тогда
		ИмяРук = СокрЛП(Строка(ЗначРук));
		Если ЗначениеЗаполнено(ИмяРук) Тогда
			НайдРук = Справочники.ФизическиеЛица.НайтиПоНаименованию(ИмяРук, Истина);
			Если ЗначениеЗаполнено(НайдРук) Тогда
				Параметры.ПолученныеДанные.Руководитель = НайдРук;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// --- ДолжностьРуководителя (ссылка Должности) — резолв по Наименованию ---
	ЗначДолжРук = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ДолжностьРуководителя", ЗначДолжРук) Тогда
		ИмяДолжРук = СокрЛП(Строка(ЗначДолжРук));
		Если ЗначениеЗаполнено(ИмяДолжРук) Тогда
			НайдДолжРук = Справочники.Должности.НайтиПоНаименованию(ИмяДолжРук, Истина);
			Если ЗначениеЗаполнено(НайдДолжРук) Тогда
				Параметры.ПолученныеДанные.ДолжностьРуководителя = НайдДолжРук;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// --- НачисленияУтверждены (булево) — галка «установлены ежемесячные начисления» ---
	ЗначНУ = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("НачисленияУтверждены", ЗначНУ) Тогда
		Попытка
			Параметры.ПолученныеДанные.НачисленияУтверждены = Булево(ЗначНУ);
		Исключение
			Параметры.ПолученныеДанные.НачисленияУтверждены = (Строка(ЗначНУ) = "true" Или ЗначНУ = Истина);
		КонецПопытки;
	КонецЕсли;

	// --- СпособРасчетаАванса (перечисление) — резолв из строки ---
	ЗначСА = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("СпособРасчетаАванса", ЗначСА) Тогда
		Если ТипЗнч(ЗначСА) = Тип("Структура") И ЗначСА.Свойство("Значение") Тогда
			ИмяСА = Строка(ЗначСА.Значение);
		Иначе
			ИмяСА = Строка(ЗначСА);
		КонецЕсли;
		Если ЗначениеЗаполнено(ИмяСА) Тогда
			Попытка
				Параметры.ПолученныеДанные.СпособРасчетаАванса = XMLЗначение(Тип("ПеречислениеСсылка.СпособыРасчетаАванса"), ИмяСА);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	// --- ОтразитьВТрудовойКнижке / НачалоТрудовойДеятельности (булево) ---
	ЗначОТК = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ОтразитьВТрудовойКнижке", ЗначОТК) Тогда
		Попытка Параметры.ПолученныеДанные.ОтразитьВТрудовойКнижке = Булево(ЗначОТК); Исключение КонецПопытки;
	КонецЕсли;
	ЗначНТД = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("НачалоТрудовойДеятельности", ЗначНТД) Тогда
		Попытка Параметры.ПолученныеДанные.НачалоТрудовойДеятельности = Булево(ЗначНТД); Исключение КонецПопытки;
	КонецЕсли;

	// --- ТрудоваяФункция (ссылка ТрудовыеФункции) — резолв по Наименованию ---
	ЗначТФ = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ТрудоваяФункция", ЗначТФ) Тогда
		ИмяТФ = СокрЛП(Строка(ЗначТФ));
		Если ЗначениеЗаполнено(ИмяТФ) Тогда
			НайдТФ = Справочники.ТрудовыеФункции.НайтиПоНаименованию(ИмяТФ, Истина);
			Если ЗначениеЗаполнено(НайдТФ) Тогда
				Параметры.ПолученныеДанные.ТрудоваяФункция = НайдТФ;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// --- НаименованиеДокумента (строка) ---
	ЗначНД = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("НаименованиеДокумента", ЗначНД) Тогда
		Попытка Параметры.ПолученныеДанные.НаименованиеДокумента = Строка(ЗначНД); Исключение КонецПопытки;
	КонецЕсли;

	// --- ВидЗаявленияОВыбореСпособаВеденияТрудовойКнижки (перечисление) + дата ---
	ЗначВЗТ = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ВидЗаявленияОВыбореСпособаВеденияТрудовойКнижки", ЗначВЗТ) Тогда
		ИмяВЗТ = Строка(ЗначВЗТ);
		Если ЗначениеЗаполнено(ИмяВЗТ) Тогда
			Попытка
				Параметры.ПолученныеДанные.ВидЗаявленияОВыбореСпособаВеденияТрудовойКнижки = XMLЗначение(Тип("ПеречислениеСсылка.ВидыЗаявленийОПредоставленииСведенийОТрудовойДеятельности"), ИмяВЗТ);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	ЗначДЗТ = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ДатаЗаявленияОВыбореСпособаВеденияТрудовойКнижки", ЗначДЗТ) И ЗначениеЗаполнено(ЗначДЗТ) Тогда
		Попытка Параметры.ПолученныеДанные.ДатаЗаявленияОВыбореСпособаВеденияТрудовойКнижки = ЗначДЗТ; Исключение КонецПопытки;
	КонецЕсли;

	// --- ИсправленныйДокумент (ссылка на исправляемый ПриемНаРаботу) — резолв по GUID ---
	ЗначИД = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("ИсправленныйДокумент", ЗначИД) Тогда
		СтрГУИД = СокрЛП(Строка(ЗначИД));
		Если ЗначениеЗаполнено(СтрГУИД) Тогда
			Попытка
				Параметры.ПолученныеДанные.ИсправленныйДокумент = Документы.ПриемНаРаботу.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрГУИД));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	// --- Проведен: помечаем документ проведённым, чтобы БСП поставил его
	//     в штатную очередь отложенного проведения (устойчиво, без срыва обмена) ---
	ЗначПров = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("Проведен", ЗначПров) Тогда
		Попытка Параметры.ПолученныеДанные.Проведен = Булево(ЗначПров); Исключение КонецПопытки;
	КонецЕсли;

	// --- Начисления (ТЧ): ссылка Начисление + Размер + ИдентификаторСтрокиВидаРасчета ---
	ЗначНач = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("Начисления", ЗначНач) И ТипЗнч(ЗначНач) = Тип("ТаблицаЗначений") Тогда
		ТЧДок = Параметры.ПолученныеДанные.Начисления;
		ЕстьКолНач = Не (ЗначНач.Колонки.Найти("Начисление") = Неопределено);
		ЕстьКолРазм = Не (ЗначНач.Колонки.Найти("Размер") = Неопределено);
		ЕстьКолИд = Не (ЗначНач.Колонки.Найти("ИдентификаторСтрокиВидаРасчета") = Неопределено);
		Инд = 0;
		Для Каждого СтрИст Из ЗначНач Цикл
			Если Инд >= ТЧДок.Количество() Тогда Прервать; КонецЕсли;
			СтрДок = ТЧДок[Инд];
			Если ЕстьКолНач Тогда
				// Сначала по GUID (в ЗУП бывают разные начисления с одинаковым наименованием), затем по наименованию.
				НайдН = УСО2КД3_НайтиПоСсылкеИлиНаименованию(СтрИст.Начисление, ПланыВидовРасчета.Начисления);
				Если ЗначениеЗаполнено(НайдН) Тогда
					СтрДок.Начисление = НайдН;
				КонецЕсли;
			КонецЕсли;
			Если ЕстьКолРазм Тогда
				Попытка СтрДок.Размер = Число(СтрИст.Размер); Исключение КонецПопытки;
			КонецЕсли;
			Если ЕстьКолИд Тогда
				Попытка СтрДок.ИдентификаторСтрокиВидаРасчета = СтрИст.ИдентификаторСтрокиВидаРасчета; Исключение КонецПопытки;
			КонецЕсли;
			Инд = Инд + 1;
		КонецЦикла;
	КонецЕсли;

	// --- Показатели (ТЧ): ссылка Показатель + Значение + ИдентификаторСтрокиВидаРасчета ---
	ЗначПок = Неопределено;
	Если Параметры.ДанныеXDTO.Свойство("Показатели", ЗначПок) И ТипЗнч(ЗначПок) = Тип("ТаблицаЗначений") Тогда
		ТЧПок = Параметры.ПолученныеДанные.Показатели;
		ЕстьКолПок = Не (ЗначПок.Колонки.Найти("Показатель") = Неопределено);
		ЕстьКолЗнач = Не (ЗначПок.Колонки.Найти("Значение") = Неопределено);
		ЕстьКолИдП = Не (ЗначПок.Колонки.Найти("ИдентификаторСтрокиВидаРасчета") = Неопределено);
		ИндП = 0;
		Для Каждого СтрИстП Из ЗначПок Цикл
			Если ИндП >= ТЧПок.Количество() Тогда Прервать; КонецЕсли;
			СтрДокП = ТЧПок[ИндП];
			Если ЕстьКолПок Тогда
				НайдП = УСО2КД3_НайтиПоСсылкеИлиНаименованию(СтрИстП.Показатель, Справочники.ПоказателиРасчетаЗарплаты);
				Если ЗначениеЗаполнено(НайдП) Тогда
					СтрДокП.Показатель = НайдП;
				КонецЕсли;
			КонецЕсли;
			Если ЕстьКолЗнач Тогда
				Попытка
					СтрДокП.Значение = Число(СтрИстП.Значение);
				Исключение
					Попытка СтрДокП.Значение = СтрИстП.Значение; Исключение КонецПопытки;
				КонецПопытки;
			КонецЕсли;
			Если ЕстьКолИдП Тогда
				Попытка СтрДокП.ИдентификаторСтрокиВидаРасчета = СтрИстП.ИдентификаторСтрокиВидаРасчета; Исключение КонецПопытки;
			КонецЕсли;
			ИндП = ИндП + 1;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти




